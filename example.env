BotToken=YOUR_BOT_TOKEN
AdminUserIds__0=123456789
AdminUserIds__1=987654321

# Host directory mounted at /app/data by Docker Compose.
# Create it before starting the container; on Linux it must be writable by UID 1654.
SECRET_SANTA_DB_DATA_PATH=./data

# Optional connection string for local dotnet run (Compose sets the container path).
ConnectionStrings__DefaultConnection=Data Source=secret_santa.db
